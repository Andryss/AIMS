<Core:StyleSheet id="55c9f36b-b9b0-5168-a8f5-b33e092f40a5">
<styleSheet>
<val>component, component &gt; compartment {
  justify-content: start;
}

c4container[children] {
  dash-style: 11 9;
  justify-content: start;
}

node, node &gt; compartment {
  justify-content: start;
}

class {
  font-size: 12;
}

c4dependency {
  font-size: 12;
}
</val>
</styleSheet>
</Core:StyleSheet>
